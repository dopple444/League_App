{
  "name": "softball-league-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant league operations platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "bootstrap": "bash tools/scripts/bootstrap-pnpm.sh",
    "dev": "turbo run dev --parallel",
    "scheduler:sync": "bash tools/scripts/scheduler-sync.sh",
    "scheduler:test": "bash tools/scripts/scheduler-test.sh",
    "scheduler:lint": "bash tools/scripts/scheduler-lint.sh",
    "scheduler:typecheck": "bash tools/scripts/scheduler-typecheck.sh",
    "toolchain:check": "node tools/scripts/toolchain-check.mjs",
    "env:init": "node tools/scripts/env-init.mjs",
    "env:init:ci": "node tools/scripts/env-init.mjs --ci",
    "env:check": "node tools/scripts/env-check.mjs",
    "compose:config": "bash tools/scripts/compose-config.sh",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "turbo run lint && pnpm scheduler:lint",
    "typecheck": "turbo run typecheck && pnpm scheduler:typecheck",
    "contracts:generate": "pnpm --filter @league/contracts contracts:generate",
    "contracts:check": "pnpm --filter @league/contracts contracts:check",
    "test": "pnpm test:unit",
    "test:unit": "turbo run test --filter=!@league/mobile && pnpm scheduler:test && pnpm test:tooling",
    "test:tooling": "node --test tools/import/*.test.mjs",
    "test:mobile": "pnpm --filter @league/mobile test",
    "build": "turbo run build",
    "stack:up": "bash tools/scripts/stack.sh up",
    "stack:down": "bash tools/scripts/stack.sh down",
    "stack:smoke": "bash tools/scripts/stack-smoke.sh",
    "db:migrate:verify": "node tools/scripts/run-with-env.mjs database-migration -- pnpm --filter @league/database db:migrate:verify",
    "db:seed:verify": "node tools/scripts/run-with-env.mjs database-seed -- pnpm --filter @league/database db:seed:verify",
    "db:restore:verify": "bash infra/backup/verify-restore.sh",
    "test:integration": "node tools/scripts/run-with-env.mjs api-test -- pnpm --filter @league/api test:integration",
    "test:tenancy": "node tools/scripts/run-with-env.mjs api-test -- pnpm --filter @league/api test:tenancy",
    "test:authz": "node tools/scripts/run-with-env.mjs api-test -- pnpm --filter @league/api test:authz",
    "test:e2e": "node tools/scripts/run-with-env.mjs web-test -- pnpm --filter @league/web test:e2e",
    "test:a11y": "node tools/scripts/run-with-env.mjs web-test -- pnpm --filter @league/web test:a11y",
    "import:trace": "node tools/import/trace-source-documents.mjs",
    "import:check": "node tools/import/trace-source-documents.mjs --check",
    "security:dependencies": "bash tools/scripts/security-dependencies.sh",
    "security:containers": "bash tools/scripts/security-containers.sh",
    "verify": "bash tools/scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "prettier": "3.8.1",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
