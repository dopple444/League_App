{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://league.invalid/schemas/source-traceability-v1.json",
  "title": "Source document traceability report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceDirectoryPresent", "overallStatus", "sources", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceDirectoryPresent": { "type": "boolean" },
    "overallStatus": {
      "enum": ["awaiting_authorized_sources", "source_review_required", "mapped"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logicalSourceId",
          "filename",
          "mediaType",
          "status",
          "sha256",
          "byteSize",
          "mappings"
        ],
        "properties": {
          "logicalSourceId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "filename": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "status": { "enum": ["absent", "present_unreviewed", "mapped"] },
          "sha256": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
          },
          "byteSize": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
          "mappings": {
            "type": "array",
            "items": { "$ref": "#/$defs/mapping" }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "sourceId", "status", "contentHash", "renderHash"],
        "properties": {
          "componentId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "sourceId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "status": { "enum": ["pending_source_review", "verified"] },
          "contentHash": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
          },
          "renderHash": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
          }
        }
      }
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLocation",
        "target",
        "transformation",
        "confidence",
        "conflict",
        "resolutionStatus"
      ],
      "properties": {
        "sourceLocation": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "conflict": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "resolutionStatus": { "enum": ["pending", "resolved"] }
      }
    }
  }
}
