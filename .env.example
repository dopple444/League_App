# Copy to .env for local development. Values below are synthetic and local-only.
NODE_ENV=development
LOG_LEVEL=info
LEAGUE_TIMEZONE=America/New_York
FEATURED_PUBLIC_ORGANIZATION_SLUG=meade-county-demo
FEATURED_PUBLIC_LEAGUE_SLUG=church-softball

GATEWAY_PORT=8080
WEB_PORT=3000
API_PORT=3001
WORKER_PORT=3002
SCHEDULER_PORT=8000

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_DISCOVERY_LIMIT=100
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_DISPATCH_ATTEMPTS=10

POSTGRES_DB=league_app
POSTGRES_USER=league_migrator
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
DATABASE_URL=postgresql://league_migrator:__GENERATE_POSTGRES_PASSWORD__@postgres:5432/league_app
HOST_DATABASE_URL=postgresql://league_migrator:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:54320/league_app
RUNTIME_DATABASE_PASSWORD=__GENERATE_RUNTIME_DATABASE_PASSWORD__
RUNTIME_DATABASE_URL=postgresql://league_runtime:__GENERATE_RUNTIME_DATABASE_PASSWORD__@postgres:5432/league_app
HOST_RUNTIME_DATABASE_URL=postgresql://league_runtime:__GENERATE_RUNTIME_DATABASE_PASSWORD__@127.0.0.1:54320/league_app
TEST_DATABASE_PASSWORD=__GENERATE_TEST_DATABASE_PASSWORD__
TEST_DATABASE_URL=postgresql://league_test:__GENERATE_TEST_DATABASE_PASSWORD__@postgres:5432/league_app_test
HOST_TEST_DATABASE_URL=postgresql://league_test:__GENERATE_TEST_DATABASE_PASSWORD__@127.0.0.1:54320/league_app_test
TEST_MIGRATOR_DATABASE_URL=postgresql://league_migrator:__GENERATE_POSTGRES_PASSWORD__@postgres:5432/league_app_test
HOST_TEST_MIGRATOR_DATABASE_URL=postgresql://league_migrator:__GENERATE_POSTGRES_PASSWORD__@127.0.0.1:54320/league_app_test

REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=league-local-admin
MINIO_ROOT_PASSWORD=__GENERATE_MINIO_PASSWORD__
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=league-local
S3_ACCESS_KEY=league-local-admin
S3_SECRET_KEY=__GENERATE_MINIO_PASSWORD__

BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=__GENERATE_BETTER_AUTH_SECRET__
DEMO_ADMIN_PASSWORD=__GENERATE_DEMO_ADMIN_PASSWORD__
WEB_ORIGIN=http://localhost:8080
API_INTERNAL_URL=http://api:3001
SCHEDULER_URL=http://scheduler:8000
MAILPIT_SMTP_URL=smtp://mailpit:1025
MOBILE_ORIGIN=league-companion://
