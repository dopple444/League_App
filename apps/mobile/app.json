{
  "expo": {
    "name": "League Companion",
    "slug": "league-companion",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "scheme": "league-companion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.synthetic.leaguecompanion"
    },
    "android": {
      "package": "org.synthetic.leaguecompanion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8080"
    }
  }
}
