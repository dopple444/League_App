{
  "name": "@league/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src test --max-warnings=0",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run test/unit --exclude 'dist/**'",
    "test:integration": "vitest run test/integration --exclude 'dist/**'",
    "test:tenancy": "vitest run test/tenancy --exclude 'dist/**'",
    "test:authz": "vitest run test/authz --exclude 'dist/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@league/auth": "workspace:*",
    "@league/contracts": "workspace:*",
    "@league/database": "workspace:*",
    "@league/domain": "workspace:*",
    "@league/observability": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "better-auth": "1.6.29",
    "fastify": "5.11.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@league/test-utils": "workspace:*",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
