{
  "name": "@league/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:verify": "tsx scripts/verify-migration.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:verify": "tsx scripts/verify-seed.ts",
    "lint": "eslint src prisma --max-warnings=0",
    "test": "vitest run --exclude 'dist/**'",
    "typecheck": "prisma validate && prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@league/auth": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "prisma": "7.9.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
